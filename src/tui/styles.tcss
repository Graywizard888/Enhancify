}

App.theme-matrix-retro .card {
    background: #041004;
    border: round #004400;
}

App.theme-matrix-retro .card:focus {
    border: round #00ff00;
}

App.theme-matrix-retro .card-title {
    color: #00ff00;
}

App.theme-matrix-retro Button {
    background: #061c06;
    border: round #004400;
    color: #00ff00;
}

App.theme-matrix-retro Button:focus {
    background: #00ff00;
    color: #000000;
    border: round #00ff00;
}

App.theme-matrix-retro Button.btn-primary {
    background: #042404;
    border: round #00ff00;
    color: #00ff00;
}

App.theme-matrix-retro Button.btn-primary:focus {
    background: #00ff00;
    color: #000000;
}

App.theme-matrix-retro ListItem {
    background: #041004;
    border-bottom: solid #002200;
}

App.theme-matrix-retro ListItem:focus {
    background: #003300;
    color: #39ff14;
}

App.theme-matrix-retro .dialog-box {
    background: #041004;
    border: round #00ff00;
}

App.theme-matrix-retro .dialog-title {
    color: #00ff00;
    border-bottom: solid #004400;
}

App.theme-matrix-retro Input {
    color: #00ff00;
    border: round #004400;
}

App.theme-matrix-retro Input:focus {
    border: round #00ff00;
}

App.theme-matrix-retro #log-viewer {
    background: #000000;
    border: round #00ff00;
    color: #00ff00;
}

App.theme-matrix-retro Bar > .bar--bar {
    color: #00ff00;
    background: #003300;
}

App.theme-matrix-retro Bar > .bar--complete {
    color: #39ff14;
}


/* ====================================================
   THEME 8: OLED MIDNIGHT DARK
   ==================================================== */

App.theme-oled-midnight Screen {
    background: #000000;
