    background: #111111;
    border: round #222222;
    color: #ffffff;
}

App.theme-oled-midnight Button:focus {
    background: #00a8ff;
    border: round #ffffff;
    color: #000000;
}

App.theme-oled-midnight Button.btn-primary {
    background: #00283d;
    border: round #00a8ff;
    color: #00a8ff;
}

App.theme-oled-midnight Button.btn-primary:focus {
    background: #00a8ff;
    color: #000000;
}

App.theme-oled-midnight ListItem:focus {
    background: #141414;
    color: #00a8ff;
}

App.theme-oled-midnight .dialog-box {
    background: #0a0a0a;
    border: round #00a8ff;
}

App.theme-oled-midnight .dialog-title {
    color: #00a8ff;
    border-bottom: solid #222222;
}

App.theme-oled-midnight Input {
    color: #00a8ff;
    border: round #222222;
}

App.theme-oled-midnight Input:focus {
    border: round #00a8ff;
}

App.theme-oled-midnight #log-viewer {
    background: #000000;
    border: round #00a8ff;
    color: #70cfff;
}

App.theme-oled-midnight Bar > .bar--bar {
    color: #00a8ff;
    background: #141414;
}

App.theme-oled-midnight Bar > .bar--complete {
    color: #ffffff;
}
