/*
 * Enhancify Textual Stylesheet (TCSS)
 * Supports Multi-Theme Architecture:
 * 1. Cybernetic Green
 * 2. Cyberpunk Neon
 * 3. Dracula Vampire
 * 4. Catppuccin Mocha
 * 5. Nordic Frost
 * 6. Sunset Amber
 * 7. Matrix Phosphor
 * 8. OLED Midnight Dark
 */

/* ====================================================
   BASE COMMON LAYOUT & WIDGETS
   ==================================================== */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

#cyber-header {
    dock: top;
    height: auto;
    background: #161b22;
    border-bottom: solid #00ff7f;
    padding: 0 1;
}

#header-title {
    text-style: bold;
    color: #00ff7f;
}

#status-bar-badges {
    layout: horizontal;
    align-horizontal: center;
    height: auto;
    margin-top: 0;
    margin-bottom: 0;
}

.badge {
    padding: 0 1;
    margin: 0 1;
    text-style: bold;
    border: round #30363d;
    background: #21262d;
    color: #c9d1d9;
}

.badge-green {
    border: round #00ff7f;
    color: #00ff7f;
    background: #0d2818;
}

.badge-cyan {
    border: round #00e5ff;
    color: #00e5ff;
    background: #072a38;
}

.badge-purple {
    border: round #d2a8ff;
    color: #d2a8ff;
    background: #261738;
}

.badge-yellow {
    border: round #ffd700;
    color: #ffd700;
    background: #2e2608;
}

.badge-pink {
    border: round #ff007f;
    color: #ff007f;
    background: #38081f;
}

.badge-mauve {
    border: round #cba6f7;
    color: #cba6f7;
    background: #2b1d3d;
}

.badge-nord {
    border: round #88c0d0;
    color: #88c0d0;
    background: #1e2c38;
}

.badge-matrix {
    border: round #00ff00;
    color: #00ff00;
    background: #002200;
}

.container-box {
    padding: 1;
    height: 1fr;
    overflow-y: auto;
}

.card {
    background: #161b22;
    border: round #30363d;
    padding: 1;
    margin-bottom: 1;
}

.card:focus {
    border: round #00ff7f;
}

.card-title {
    text-style: bold;
    color: #00ff7f;
    margin-bottom: 0;
}

.card-desc {
    color: #8b949e;
    margin-bottom: 1;
}

Button {
    background: #21262d;
    color: #e6edf3;
    border: round #30363d;
    height: 3;
    min-width: 16;
    margin: 0 1 1 0;
    text-style: bold;
}

Button:hover {
    background: #30363d;
    border: round #00ff7f;
    color: #ffffff;
}

Button:focus {
    background: #238636;
    border: round #00ff7f;
    color: #ffffff;
}

Button.btn-primary {
    background: #0d4429;
    border: round #00ff7f;
    color: #00ff7f;
}

Button.btn-primary:focus {
    background: #00ff7f;
    color: #000000;
}

Button.btn-danger {
    background: #490202;
    border: round #ff4444;
    color: #ff6666;
}

Button.btn-danger:focus {
    background: #ff4444;
    color: #ffffff;
}

Button.btn-secondary {
    background: #1f242c;
    border: round #8b949e;
    color: #c9d1d9;
}

ListView {
    background: #0d1117;
    border: round #30363d;
    height: 1fr;
    padding: 0;
}

ListItem {
    padding: 1;
    background: #161b22;
    border-bottom: solid #21262d;
}

ListItem:hover {
    background: #21262d;
}

ListItem:focus {
    background: #0d3826;
    color: #00ff7f;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.dialog-box {
    width: 85%;
    max-width: 70;
    height: auto;
    max-height: 85%;
    background: #161b22;
    border: round #00ff7f;
    padding: 1 2;
    overflow-y: auto;
}

.dialog-title {
    text-style: bold;
    color: #00ff7f;
    border-bottom: solid #30363d;
    padding-bottom: 1;
    margin-bottom: 1;
    text-align: center;
}

.dialog-message {
    color: #c9d1d9;
    margin-bottom: 1;
}

.dialog-buttons {
    layout: horizontal;
    align-horizontal: center;
    margin-top: 1;
    height: auto;
}

Input {
    background: #0d1117;
    border: round #30363d;
    color: #00ff7f;
    margin-bottom: 1;
}

Input:focus {
    border: round #00ff7f;
}

#log-viewer {
    background: #05080c;
    border: round #00ff7f;
    color: #a8ffb2;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
}

ProgressBar {
    margin: 1 0;
}

Bar > .bar--bar {
    color: #00ff7f;
    background: #0d3826;
}

Bar > .bar--complete {
    color: #00ff7f;
}


/* ====================================================
   THEME 2: CYBERPUNK NEON
   ==================================================== */

App.theme-cyberpunk-neon Screen {
    background: #0c0817;
    color: #f0f6fc;
}

App.theme-cyberpunk-neon #cyber-header {
    background: #171126;
    border-bottom: solid #ff007f;
}

App.theme-cyberpunk-neon #header-title {
    color: #ff007f;
}

App.theme-cyberpunk-neon .card {
    background: #171126;
    border: round #38225c;
}

App.theme-cyberpunk-neon .card:focus {
    border: round #ff007f;
}

App.theme-cyberpunk-neon .card-title {
    color: #ff007f;
}

App.theme-cyberpunk-neon Button.btn-primary {
    background: #4a0028;
    border: round #ff007f;
    color: #ff007f;
}

App.theme-cyberpunk-neon Button.btn-primary:focus {
    background: #ff007f;
    color: #ffffff;
}

App.theme-cyberpunk-neon Button:focus {
    background: #a30052;
    border: round #00f0ff;
    color: #ffffff;
}

App.theme-cyberpunk-neon ListItem:focus {
    background: #380826;
    color: #00f0ff;
}

App.theme-cyberpunk-neon .dialog-box {
    background: #171126;
    border: round #ff007f;
}

App.theme-cyberpunk-neon .dialog-title {
    color: #ff007f;
    border-bottom: solid #38225c;
}

App.theme-cyberpunk-neon Input {
    color: #00f0ff;
    border: round #38225c;
}

App.theme-cyberpunk-neon Input:focus {
    border: round #ff007f;
}

App.theme-cyberpunk-neon #log-viewer {
    background: #07040d;
    border: round #ff007f;
    color: #ff80c0;
}

App.theme-cyberpunk-neon Bar > .bar--bar {
    color: #ff007f;
    background: #380826;
}

App.theme-cyberpunk-neon Bar > .bar--complete {
    color: #00f0ff;
}


