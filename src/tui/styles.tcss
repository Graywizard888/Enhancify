/* ====================================================
   THEME 7: MATRIX PHOSPHOR
   ==================================================== */

App.theme-matrix-retro Screen {
    background: #000000;
    color: #00ff00;
}

App.theme-matrix-retro #cyber-header {
    background: #041004;
    border-bottom: solid #00ff00;
}

App.theme-matrix-retro #header-title {
